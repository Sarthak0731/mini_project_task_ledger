{
  "name": "taskledger",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "npx concurrently \"npm run dev --workspace backend\" \"npm run start --workspace frontend\"",
    "start-backend": "npm run dev --workspace backend",
    "start-frontend": "npm run start --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
